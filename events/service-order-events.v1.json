{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Garage Management Service Order Events v1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "correlationId", "occurredAt", "serviceOrderId"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "type": "string",
      "enum": [
        "ServiceOrderOpened",
        "QuoteRequested",
        "QuoteApproved",
        "PaymentApproved",
        "PaymentRejected",
        "ExecutionRequested",
        "ExecutionCompleted",
        "SagaCompensationRequested"
      ]
    },
    "eventVersion": { "type": "integer", "const": 1 },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "serviceOrderId": { "type": "string", "format": "uuid" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
